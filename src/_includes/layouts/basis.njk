{%- set seitentitel = (titel ~ " · " ~ site.name) if (titel and not startseite) else (site.name ~ " · " ~ site.unterzeile) -%}
{%- set standardBeschreibung = site.name ~ ": " ~ site.unterzeile ~ ". Erste Sätze, Leseproben und Kontakt für Agenturen und Verlage." -%}
{%- set seitenbeschreibung = beschreibung or (site.beschreibung | ohneTodo(standardBeschreibung)) -%}
{%- set bild = (ogBild or "/assets/og/start.png") | absolut(site.url) -%}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seitentitel }}</title>
  <meta name="description" content="{{ seitenbeschreibung }}">
  {%- if ohneIndex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="canonical" href="{{ page.url | absolut(site.url) }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#fdfdfb" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/literata-roman.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css?v={{ cssVersion }}">

  <meta property="og:type" content="{{ ogTyp or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="de_DE">
  <meta property="og:title" content="{{ seitentitel }}">
  <meta property="og:description" content="{{ seitenbeschreibung }}">
  <meta property="og:url" content="{{ page.url | absolut(site.url) }}">
  <meta property="og:image" content="{{ bild }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  {%- if site.goatcounter %}
  <script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  {%- endif %}
</head>
<body{% if koerperklasse %} class="{{ koerperklasse }}"{% endif %}>
  <a class="sprungmarke" href="#inhalt">Zum Inhalt</a>
  {%- if not ohneKopf %}
  {% include "partials/kopf.njk" %}
  {%- endif %}
  <main id="inhalt">
{{ content | safe }}
  </main>
  {%- if not ohneKopf %}
  {% include "partials/fuss.njk" %}
  {%- endif %}
</body>
</html>
