{#- Bausteine rund um ein Buch: Titelblatt, Farbe, Downloads, Zitate. -#}

{% macro farbe(buch) -%}
--buch-hell: {{ buch.farbe.hell }}; --buch-akzent: {{ buch.farbe.akzent }}
{%- endmacro %}

{% macro titelblatt(buch, name, klasse = "") %}
<div class="titelblatt {{ klasse }}" style="{{ farbe(buch) }}" aria-hidden="true">
  <span class="titelblatt-autorin">{{ name }}</span>
  <span class="titelblatt-mitte">
    <span class="titelblatt-titel">{{ buch.titel }}</span>
    <span class="titelblatt-strich"></span>
  </span>
  <span class="titelblatt-gattung">{{ buch.gattung }}{% if buch.band %} · Band {{ buch.band }}{% endif %}</span>
</div>
{% endmacro %}

{#- Hinweis auf die Reihe: „Band 2 · Fortsetzung zu Ich fahr dich.“ bzw. „Band 1 · Fortsetzung: Waten in Zement“ -#}
{% macro reihe(buch, liste) -%}
{%- if buch.vorgaenger %}{% set v = liste | findeBuch(buch.vorgaenger) %}Band {{ buch.band }} · Fortsetzung zu <a href="/buecher/{{ v.slug }}/"><cite>{{ v.titel }}</cite></a>
{%- elif buch.fortsetzung %}{% set f = liste | findeBuch(buch.fortsetzung) %}Band {{ buch.band }} · Fortsetzung: <a href="/buecher/{{ f.slug }}/"><cite>{{ f.titel }}</cite></a>
{%- endif %}
{%- endmacro %}

{% macro umfang(buch) -%}
{%- if buch.woerterZahl %}{{ buch.woerterZahl | zahl }} Wörter{% endif -%}
{%- if buch.normseitenZahl %} · {% if buch.normseitenGeschaetzt %}≈ {% endif %}{{ buch.normseitenZahl | zahl }} Normseiten{% endif -%}
{%- endmacro %}

{% macro downloads(buch) %}
{%- set epub = "/downloads/" ~ buch.dateiBasis ~ ".epub" -%}
{%- set pdf = "/downloads/" ~ buch.dateiBasis ~ ".pdf" -%}
{%- set was = "Buch" if buch.vollstaendig else "Leseprobe" -%}
{%- if (epub | existiert) or (pdf | existiert) %}
<ul class="downloads" aria-label="{{ was }} herunterladen">
  {%- if epub | existiert %}
  <li><a href="{{ epub }}" download data-goatcounter-click="download-{{ buch.dateiBasis }}-epub"><span class="downloads-format">{{ was }} als EPUB</span> <span class="downloads-info">für E-Reader und Handy · {{ epub | dateigroesse }}</span></a></li>
  {%- endif %}
  {%- if pdf | existiert %}
  <li><a href="{{ pdf }}" download data-goatcounter-click="download-{{ buch.dateiBasis }}-pdf"><span class="downloads-format">{{ was }} als PDF</span> <span class="downloads-info">zum Drucken und für Tablets · {{ pdf | dateigroesse }}</span></a></li>
  {%- endif %}
</ul>
{%- endif %}
{% endmacro %}

{#- Wechselnde Zitate. liste: Zitate, buecher: angereicherte Buchliste, titel: Überschrift -#}
{% macro zitate(liste, buecher, titel, mitBuch = true) %}
{%- if liste.length %}
<section class="zitate" aria-labelledby="zitate-titel" data-zitate>
  <h2 id="zitate-titel" class="abschnitt-titel">{{ titel }}</h2>
  <ul class="zitate-liste">
    {%- for z in liste %}
    {%- set b = buecher | findeBuch(z.buch) %}
    <li class="buch-farbe" style="{{ farbe(b) }}" data-buch="{{ z.buch }}" data-wer="{{ z.wer }}">
      <blockquote class="zitat">
        <p>{{ z.text | zitieren | replace("\n", "<br>") | safe }}</p>
      </blockquote>
      <span class="zitat-quelle">{% if z.wer %}{{ z.wer }}{% if mitBuch %}, in {% endif %}{% endif %}{% if mitBuch %}<a href="/buecher/{{ b.slug }}/"><cite>{{ b.titel }}</cite></a>{% endif %}</span>
    </li>
    {%- endfor %}
  </ul>
  <div class="zitate-uhr" aria-hidden="true"></div>
  <div class="zitate-steuerung">
    <div class="zitate-blaettern">
      <button type="button" data-zurueck aria-label="Vorheriges Zitat"><span aria-hidden="true">‹</span><span class="zitate-wort"> zurück</span></button>
      <span class="zitate-zaehler" aria-live="polite"></span>
      <button type="button" data-weiter aria-label="Nächstes Zitat"><span class="zitate-wort">weiter </span><span aria-hidden="true">›</span></button>
    </div>
    <button type="button" class="zitate-pause" data-pause aria-pressed="false">anhalten</button>
  </div>
</section>
{%- endif %}
{% endmacro %}
