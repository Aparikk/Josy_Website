---
layout: layouts/basis.njk
titel: Für Agenturen und Verlage
beschreibung: "Manuskripte, Leseproben, Kurzvita und Kontakt von Josie H. Matchèque für Literaturagenturen und Verlage."
---
{%- set liste = buecher | buchliste(manuskripte) -%}
<div class="seite">
  <header class="seiten-kopf">
    <h1 class="seiten-titel">Für Agenturen und Verlage</h1>
    <p class="seiten-einleitung">{{ site.status }}</p>
  </header>

  <section aria-labelledby="manuskripte">
    <h2 id="manuskripte" class="abschnitt-titel">Manuskripte</h2>
    <div class="tabelle-rahmen">
      <table class="tabelle">
        <thead><tr><th scope="col">Titel</th><th scope="col">Gattung</th><th scope="col" class="zahl">Wörter</th><th scope="col" class="zahl">Normseiten</th><th scope="col">Entstanden</th><th scope="col">Lesen</th></tr></thead>
        <tbody>
          {%- for buch in liste %}
          <tr>
            <th scope="row"><a href="/buecher/{{ buch.slug }}/">{{ buch.titel }}</a>{% if buch.slug in site.angeboten %}<span class="angeboten">angeboten</span>{% elif buch.vollstaendig %}<span class="frei">frei</span>{% endif %}</th>
            <td data-label="Gattung">{{ buch.genre or buch.gattung }}</td>
            <td data-label="Wörter" class="zahl">{{ buch.woerterZahl | zahl or "–" }}</td>
            <td data-label="Normseiten" class="zahl">{% if buch.normseitenZahl %}{% if buch.normseitenGeschaetzt %}≈ {% endif %}{{ buch.normseitenZahl | zahl }}{% else %}–{% endif %}</td>
            <td data-label="Entstanden">{{ buch.entstanden or "–" }}</td>
            <td data-label="Lesen">{% if buch.hatText %}<a href="/buecher/{{ buch.slug }}/leseprobe/">{{ "vollständig" if buch.vollstaendig else "Leseprobe" }}</a>{% else %}–{% endif %}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="anfrage">
    <h2 id="anfrage" class="abschnitt-titel">Auf Anfrage</h2>
    <p>Exposé, Leseprobe und vollständiges Manuskript per E-Mail:</p>
    <p class="email-gross"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  </section>

  <section aria-labelledby="steckbrief">
    <h2 id="steckbrief" class="abschnitt-titel">Auf einen Blick</h2>
    <dl class="steckbrief">
      <div><dt>Themen</dt><dd>{{ site.themen }}</dd></div>
      <div><dt>Genre</dt><dd>{{ site.genre }}</dd></div>
      <div><dt>Vergleichbar mit</dt><dd>{{ site.vergleichbar }}</dd></div>
    </dl>
  </section>

  <section aria-labelledby="kurzvita">
    <h2 id="kurzvita" class="abschnitt-titel">Kurzvita</h2>
    <div class="kopierbar">
      <div class="fliesstext" id="kurzvita-text">{{ site.kurzvita | md | safe }}</div>
      <button class="knopf knopf--leise" type="button" data-kopieren="kurzvita-text" hidden>Kurzvita kopieren</button>
    </div>
  </section>

  {%- if site.pressefotos %}
  <section aria-labelledby="fotos">
    <h2 id="fotos" class="abschnitt-titel">Pressefoto</h2>
    <p><a href="/assets/img/portrait-hoch.jpg" download>Porträt herunterladen</a>{% if site.fotografie %} · Foto: {{ site.fotografie }}{% endif %}</p>
  </section>
  {%- endif %}
</div>
<script src="/assets/js/kopieren.js" defer></script>
