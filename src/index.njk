---
layout: layouts/basis.njk
startseite: true
koerperklasse: startseite
ogBild: /assets/og/start.png
---
{%- from "partials/buch.njk" import farbe, reihe, zitate as zitatGalerie -%}
{%- set liste = buecher | buchliste(manuskripte) -%}

<section class="auftakt" aria-labelledby="auftakt-titel">
  <p class="auftakt-motto"><abbr title="Quod erat scribendum">{{ site.motto }}</abbr></p>
  <p class="auftakt-titel" id="auftakt-titel">{{ site.leitsatz }}</p>
  <div class="auftakt-text">{{ site.einleitung | md | safe }}</div>
  {%- if site.neuigkeit %}
  <p class="neuigkeit"><span class="neuigkeit-marke">Neu</span> {{ site.neuigkeit | mdInline | safe }}</p>
  {%- endif %}
</section>

{%- for buch in liste %}
<p class="ornament" aria-hidden="true">⁂</p>
<section class="incipit buch-farbe" style="{{ farbe(buch) }}" aria-label="{{ buch.titel }}">
  <figure class="incipit-figur">
    {%- if buch.vorgaenger or buch.fortsetzung %}
    <p class="incipit-reihe">{{ reihe(buch, liste) }}</p>
    {%- endif %}
    {%- if buch.anfang %}
    {#- Von Josie ausgewählter Anfang: wortgetreu, ohne zusätzliche Anführungszeichen #}
    <blockquote class="incipit-satz incipit-satz--{{ buch.anfang | satzlaenge }}{% if buch.anfang | haengt %} haengt{% endif %}" cite="{{ ('/buecher/' ~ buch.slug ~ '/') | absolut(site.url) }}">
      {{ buch.anfang | md | safe }}
    </blockquote>
    {%- else %}
    {%- set satz = buch.satz | zitieren %}
    <blockquote class="incipit-satz incipit-satz--{{ satz | satzlaenge }}{% if satz | haengt %} haengt{% endif %}" cite="{{ ('/buecher/' ~ buch.slug ~ '/') | absolut(site.url) }}">
      <p>{{ satz }}</p>
    </blockquote>
    {%- endif %}
    <figcaption class="incipit-quelle">
      <a class="incipit-titel" href="/buecher/{{ buch.slug }}/"><cite>{{ buch.titel }}</cite></a>
      <span class="incipit-gattung">{{ buch.gattung }}</span>
      {%- if buch.hatText %}
      <a class="incipit-weiter" href="/buecher/{{ buch.slug }}/leseprobe/">Weiterlesen <span aria-hidden="true">→</span></a>
      {%- else %}
      <a class="incipit-weiter" href="/buecher/{{ buch.slug }}/">Zum Buch <span aria-hidden="true">→</span></a>
      {%- endif %}
    </figcaption>
  </figure>
</section>
{%- endfor %}

<p class="ornament" aria-hidden="true">⁂</p>
{{ zitatGalerie(zitate, liste, "Aus den Büchern") }}

<section class="vorstellung" aria-labelledby="vorstellung-titel">
  <img class="vorstellung-bild" src="/assets/img/portrait-hoch.jpg" alt="Porträt von {{ site.name }}" sizes="(min-width: 56em) 19rem, 70vw">
  <div class="vorstellung-text">
    <h2 id="vorstellung-titel" class="abschnitt-titel">Über mich</h2>
    <div class="fliesstext">{{ site.kurzvita | md | safe }}</div>
    <ul class="weiter-liste">
      <li><a href="/ueber-mich/">Mehr über mich <span aria-hidden="true">→</span></a></li>
      <li><a href="/agenturen/">Für Agenturen und Verlage <span aria-hidden="true">→</span></a></li>
      <li><a href="/kontakt/">Kontakt <span aria-hidden="true">→</span></a></li>
    </ul>
  </div>
</section>

<script src="/assets/js/zitate.js" defer></script>
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": site.name,
  "url": site.url,
  "jobTitle": "Autorin",
  "email": "mailto:" ~ site.email,
  "image": ("/assets/img/portrait-hoch.jpg" | absolut(site.url))
} | json | safe }}
</script>
